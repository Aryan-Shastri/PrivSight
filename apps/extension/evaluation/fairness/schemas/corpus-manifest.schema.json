{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://privsight.local/schemas/fairness-corpus-manifest-1.0.0.json","title":"PrivSight licensed evaluation corpus","type":"object","additionalProperties":false,"required":["schema_version","corpus_name","items"],
  "properties":{"schema_version":{"const":"1.0.0"},"corpus_name":{"type":"string","minLength":1},"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/item"}}},
  "$defs":{
    "item":{"type":"object","additionalProperties":false,"required":["id","path","media_type","split","site_id","session_id","provenance","license","context","annotations"],"properties":{"id":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"media_type":{"type":"string","minLength":1},"split":{"enum":["train","validation","test"]},"site_id":{"type":"string","minLength":1},"session_id":{"type":"string","minLength":1},"provenance":{"$ref":"#/$defs/provenance"},"license":{"$ref":"#/$defs/license"},"context":{"$ref":"#/$defs/context"},"annotations":{"type":"array","items":{"$ref":"#/$defs/region"}}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["source_url","collected_at","collector","method","content_sha256"],"properties":{"source_url":{"type":"string","minLength":1},"collected_at":{"type":"string","minLength":1},"collector":{"type":"string","minLength":1},"method":{"type":"string","minLength":1},"content_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "license":{"type":"object","additionalProperties":false,"required":["spdx_id","license_url","attribution"],"properties":{"spdx_id":{"type":"string","minLength":1},"license_url":{"type":"string","minLength":1},"attribution":{"type":"string","minLength":1}}},
    "context":{"type":"object","additionalProperties":false,"required":["languages","direction","contrast","zoom_percent","accessibility","subgroups"],"properties":{"languages":{"type":"array","items":{"type":"string"}},"direction":{"enum":["ltr","rtl","mixed","unknown"]},"contrast":{"enum":["normal","high","forced-colors","unknown"]},"zoom_percent":{"type":"number","minimum":25},"accessibility":{"type":"array","items":{"type":"string"}},"subgroups":{"type":"array","items":{"type":"string"}}}},
    "region":{"type":"object","required":["id","class","bbox"],"properties":{"id":{"type":"string"},"class":{"enum":["ui","text","face","sensitive"]},"bbox":{"type":"array","prefixItems":[{"type":"number","minimum":0},{"type":"number","minimum":0},{"type":"number","exclusiveMinimum":0},{"type":"number","exclusiveMinimum":0}],"items":false},"ui_role":{"type":"string"},"text_language":{"type":"string"},"text_direction":{"enum":["ltr","rtl","mixed"]},"sensitive_type":{"type":"string"},"occluded":{"type":"boolean"}},"allOf":[{"if":{"properties":{"class":{"const":"sensitive"}}},"then":{"required":["sensitive_type"]}}],"additionalProperties":false}
  }
}
